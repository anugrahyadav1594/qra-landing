# ─────────────────────────────────────────────────────────────────────────
# QRA backend configuration
# Copy to `.env` (same folder) and edit freely — every value here overrides
# the default. NOTHING is hard-coded in the app; restart the backend after
# changing a value. Section numbers refer to ARCHITECTURE.md.
# ─────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/qra.db
# Optional: shared rate-limit backend (production path, §5.1 Upstash Redis).
# Leave empty for the built-in in-memory limiter (fine for local testing).
REDIS_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=true
ENFORCE_ORIGIN_CHECK=false

# ── Capacity / user limits (§22.3, assumption A2) ────────────────────────
MAX_REGISTERED_USERS=50000
MAX_CONCURRENT_SESSIONS=2000
SUSTAINED_REQUESTS_PER_SECOND=40
BURST_REQUESTS_PER_SECOND=300
BURST_WINDOW_SECONDS=300
MAX_WAITLIST_ENTRIES=50000

# ── Rate limits: waitlist (§9.7) ──────────────────────────────────────────
WAITLIST_PER_IP_PER_HOUR=10
WAITLIST_PER_IP_PER_MINUTE=3
WAITLIST_PER_EMAIL_PER_DAY=30
WAITLIST_PER_EMAIL_PER_HOUR=5
WAITLIST_PER_PRODUCT_PER_DAY=200

# ── Rate limits: feedback (§10.1, §10.3) ──────────────────────────────────
FEEDBACK_PER_IP_PER_MINUTE=5
FEEDBACK_PER_IP_PER_DAY=20
FEEDBACK_PER_USER_PER_DAY=20
FEEDBACK_AUTHENTICATED_PER_DAY=100
FEEDBACK_SECURITY_CATEGORY_PER_IP_PER_DAY=5

# ── Rate limits: auth / OTP budgets (§11.4, §11.6) ────────────────────────
OTP_CODE_TTL_MINUTES=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_VERIFY_LOCKOUT_MINUTES=15
OTP_REQUESTS_PER_PHONE_PER_15_MIN=3
OTP_REQUESTS_PER_PHONE_PER_DAY=5
OTP_REQUESTS_PER_IP_PER_HOUR=10
OTP_REQUEST_COOLDOWN_SECONDS=60
SIGNIN_ATTEMPTS_PER_IP_PER_15_MIN=10
SIGNIN_ATTEMPTS_PER_USER_PER_DAY=10

# ── Rate limits: general API (§13.4) ──────────────────────────────────────
PUBLIC_READ_PER_IP_PER_MINUTE=120
AUTHED_API_PER_USER_PER_MINUTE=300
IDENTITY_API_PER_CLIENT_PER_MINUTE=100
IDENTITY_API_PER_CLIENT_PER_DAY=1000
ADMIN_API_PER_ADMIN_PER_MINUTE=60
UPLOAD_PRESIGN_PER_USER_PER_HOUR=10
EXPORT_PER_USER_PER_DAY=1
DELETE_REQUESTS_PER_IP_PER_DAY=2

# ── Rate limits: careers ──────────────────────────────────────────────────
CAREERS_APPLY_PER_IP_PER_HOUR=5

# ── Spam protection (§10.3) ───────────────────────────────────────────────
# Field name the frontend honeypot must use (keep in sync with
# frontend/.env.local NEXT_PUBLIC_HONEYPOT_FIELD_NAME).
HONEYPOT_FIELD_NAME=company_website
MIN_SUBMIT_TIME_SECONDS=3
BLOCK_DISPOSABLE_EMAILS=true
DISPOSABLE_DOMAINS_EXTRA=

# ── Idempotency & dedupe ──────────────────────────────────────────────────
IDEMPOTENCY_KEY_TTL_HOURS=24
FEEDBACK_DEDUPE_WINDOW_HOURS=24

# ── Cloudflare Turnstile (skipped while empty) ────────────────────────────
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# ── Uploads (careers CV; §14.4 v1: PDF only) ──────────────────────────────
MAX_RESUME_SIZE_MB=10
MAX_COVER_NOTE_CHARS=4000
UPLOAD_DIR=uploads

# ── Consent (§16.3) ───────────────────────────────────────────────────────
POLICY_VERSION=1.0

# ── Content limits (§15.3) ────────────────────────────────────────────────
FEEDBACK_MESSAGE_MAX_CHARS=4000
FEEDBACK_MESSAGE_MIN_CHARS=10
FEEDBACK_URL_MAX_CHARS=500
REFERRAL_CODE_MAX_CHARS=64
NAME_MAX_CHARS=200

# ─────────────────────────────────────────────────────────────────────────
# MUMBAI TRADING TOURNAMENT (MTT)
# ─────────────────────────────────────────────────────────────────────────

# Administrators, by verified email (comma separated). These addresses are
# granted the admin role the first time they sign in; further admins can be
# granted from the DB (tournament_admin_roles) later.
TOURNAMENT_ADMIN_EMAILS=

# Passwordless identity (built-in email one-time-code flow).
MTT_SESSION_TTL_HOURS=720
MTT_SESSION_COOKIE_NAME=mtt_session
# Set true behind HTTPS in production (forced true when ENVIRONMENT=production).
MTT_SESSION_COOKIE_SECURE=false
MTT_OTP_TTL_MINUTES=10
MTT_OTP_MAX_ATTEMPTS=5
MTT_OTP_LENGTH=6
MTT_OTP_REQUESTS_PER_EMAIL_PER_HOUR=5
MTT_OTP_REQUESTS_PER_IP_PER_HOUR=30

# Registration budgets.
MTT_REGISTRATIONS_PER_IP_PER_HOUR=5
MTT_REGISTRATIONS_PER_EMAIL_PER_DAY=3

# Logo uploads (PNG / JPG / WebP only — SVG is refused on purpose).
MTT_MAX_LOGO_SIZE_MB=4
STORAGE_BACKEND=local          # local | s3 (s3 requires boto3 + S3_BUCKET)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=

# Dev convenience: return the one-time code in the API response so the
# journey can be completed without an SMTP server. NEVER honoured when
# ENVIRONMENT=production.
MTT_EXPOSE_OTP_IN_RESPONSE=false

# Optional external identity provider. Leave both empty to use the built-in
# passwordless flow (the default). Requires `pip install "pyjwt[crypto]"`.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=

# Outbound email (registration confirmations and one-time codes).
# Empty SMTP_HOST → messages are logged instead of sent; the platform keeps
# working end to end.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@quantrelic.in
SMTP_STARTTLS=true

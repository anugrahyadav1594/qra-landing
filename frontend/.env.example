# ─────────────────────────────────────────────────────────────────────────
# QRA frontend configuration — copy to `.env.local` and edit as needed.
# NEXT_PUBLIC_* values are visible to the browser; everything else is
# server-only.
# ─────────────────────────────────────────────────────────────────────────

# Where the FastAPI backend listens (server-side proxy target).
# The browser itself always calls same-origin /api/v1/... paths.
BACKEND_URL=http://127.0.0.1:8000

# Public site URL (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match HONEYPOT_FIELD_NAME in backend/.env — the hidden trap field
# both sides agree on. Bots that fill it get silently dropped.
NEXT_PUBLIC_HONEYPOT_FIELD_NAME=company_website

# Cloudflare Turnstile site key (leave empty to disable the widget;
# the backend must have the matching TURNSTILE_SECRET_KEY set).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Resume upload cap shown/validated client-side (keep in sync with
# MAX_RESUME_SIZE_MB in backend/.env).
NEXT_PUBLIC_MAX_RESUME_SIZE_MB=10

# Optional real contact addresses. Leave empty to hide them from the site —
# the UI falls back to "use the form and we'll get back to you", and
# /security.txt points at the contact page instead. Never invent addresses.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=

# ── Identity (Clerk) ─────────────────────────────────────────────────────
# Clerk provides sign-in / sign-up. Set both keys in any deployed
# environment; keyless local setups render the public site without the auth
# controls instead of failing every route.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
